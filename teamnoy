<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TEAMNOY</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
font-family:Arial,sans-serif;
background:#08050d;
color:white;
min-height:100vh;
}

header{
padding:25px 7%;
display:flex;
justify-content:space-between;
align-items:center;
border-bottom:1px solid #24152f;
}

.logo{
font-size:25px;
font-weight:bold;
color:#c875ff;
text-shadow:0 0 15px #9b35ff;
}

.btn{
background:#9b35ff;
color:white;
padding:12px 20px;
border-radius:10px;
text-decoration:none;
font-weight:bold;
box-shadow:0 0 20px #7b20d8;
}

.hero{
text-align:center;
padding:90px 20px 50px;
}

.hero h1{
font-size:55px;
color:#d58aff;
text-shadow:0 0 25px #9b35ff;
}

.hero p{
margin-top:15px;
color:#aaa;
}

.card{
width:90%;
max-width:700px;
margin:35px auto;
padding:30px;
background:#100b18;
border:1px solid #6d249b;
border-radius:18px;
box-shadow:0 0 30px #36104d;
}

.card h2{
margin-bottom:20px;
color:#d58aff;
}

input{
width:100%;
padding:14px;
margin:8px 0 15px;
border-radius:9px;
border:1px solid #54206f;
background:#08050d;
color:white;
outline:none;
}

input:focus{
border-color:#c05cff;
box-shadow:0 0 10px #7b20d8;
}

.join{
display:block;
text-align:center;
margin-top:15px;
background:#9b35ff;
padding:14px;
border-radius:10px;
color:white;
text-decoration:none;
font-weight:bold;
}

footer{
text-align:center;
padding:40px;
color:#666;
}
</style>
</head>

<body>

<header>
<div class="logo">TEAMNOY</div>
<a class="btn" href="#world">ENTER</a>
</header>

<section class="hero">
<h1>TEAMNOY</h1>
<p>Your world. Your community.</p>
</section>

<div class="card" id="world">
<h2>WORLD INFORMATION</h2>

<label>World Name</label>
<input id="worldName" value="TEAMNOY WORLD">

<label>World Link</label>
<input id="worldLink" value="https://example.com">

<a id="joinButton" class="join" href="https://example.com" target="_blank">
ENTER WORLD
</a>
</div>

<footer>
© 2026 TEAMNOY
</footer>

<script>
const nameInput=document.getElementById("worldName");
const linkInput=document.getElementById("worldLink");
const button=document.getElementById("joinButton");

function updateWorld(){
button.textContent="ENTER "+nameInput.value;
button.href=linkInput.value;
}

nameInput.addEventListener("input",updateWorld);
linkInput.addEventListener("input",updateWorld);
</script>

</body>
</html>
